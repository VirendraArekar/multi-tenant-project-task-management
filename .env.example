# ========================================================
# TeamBoard Multi-Tenant SaaS - Environment Template
# ========================================================
# Copy this file to .env or run ./setup.sh to generate secure random secrets:
#   cp .env.example .env
# ========================================================

# MySQL Configuration
MYSQL_DATABASE=teamboard
MYSQL_USER=teamboard_user
MYSQL_PASSWORD=change_this_password_in_production
MYSQL_ROOT_PASSWORD=change_this_root_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/teamboard?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=teamboard_user
SPRING_DATASOURCE_PASSWORD=change_this_password_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT Security Configuration (256-bit+ base64 key)
JWT_SECRET=dGVhbWJvYXJkLXN1cGVyLXNlY3JldC1qd3Qta2V5LXdpdGgtYXQtbGVhc3QtMjU2LWJpdHMtbG9uZw==
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# CORS & Gateway Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Monitoring (Prometheus / Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
